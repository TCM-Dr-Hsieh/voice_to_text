# Text files are stored with LF in the repository; Git converts to the platform's line ending on checkout.
* text=auto

# Windows scripts must have CRLF line endings on every platform (cmd.exe / Windows PowerShell 5.1).
# setup.ps1 also needs its UTF-8 BOM, which Git keeps as is.
*.cmd text eol=crlf
*.ps1 text eol=crlf
